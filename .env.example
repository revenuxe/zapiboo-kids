# Populate .env.local from your CLI login with npm run supabase:connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server credentials for Supabase edge functions belong in that service's
# secret configuration, not in browser environment variables.
